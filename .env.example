# =====================================================================
# RLNA — environment template. Copy to `.env` and fill in real values.
# `.env` is git-ignored. Never commit real credentials.
# =====================================================================

# ---------- Database (Neon PostgreSQL) ----------
# Spring Boot reads DATABASE_URL and converts it to a JDBC URL at startup.
DATABASE_URL=postgresql://user:password@host.neon.tech/RLNA?sslmode=require

# ---------- Neon Auth (Better Auth) ----------
# Base URL of the Neon Auth server for this project/branch.
NEON_AUTH_BASE_URL=
# JWKS endpoint used by Spring Boot to verify access tokens offline.
NEON_AUTH_JWKS_URL=
# Expected `iss` claim on issued access tokens. Neon Auth issues the server
# ORIGIN only, without the /<db>/auth path that NEON_AUTH_BASE_URL carries.
NEON_AUTH_ISSUER=

# ---------- Object storage: Backblaze B2 (S3-compatible API) ----------
# From the B2 console: create a private bucket, then an application key scoped
# to it. The key id is the access key, the application key is the secret.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=rlna-papers
# Endpoint shown on the bucket, e.g. https://s3.us-west-004.backblazeb2.com
B2_ENDPOINT=
# The region is the middle segment of that endpoint, e.g. us-west-004.
# B2 signs requests over it, so a wrong value fails authentication.
B2_REGION=
B2_SIGNED_URL_TTL_SECONDS=300
# Leave false for B2. Only a local S3-compatible stand-in needs path-style URLs.
B2_FORCE_PATH_STYLE=false

# ---------- LLM providers ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ---------- AI behaviour ----------
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_PROVIDER_COOLDOWN_SECONDS=60
# Provider order per tier, comma separated. Blank uses the built-in order,
# which is set by measured free-tier capacity rather than model prestige.
LLM_STRONG_ORDER=
LLM_FAST_ORDER=
AI_CACHE_ENABLED=true
DUAL_MODEL_VERIFICATION=false

# ---------- Embeddings & retrieval ----------
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
RETRIEVAL_TOP_K=8
# Hard cap on evidence sent to a model in one request. Free provider
# tiers are the binding constraint: Groq allows 8,000 tokens/minute and
# rejects a bigger single request with 413. Raise it on a paid tier.
MAX_CONTEXT_CHARACTERS=18000
RETRIEVAL_MIN_SCORE=0.35
SECTION_BOOST_FACTOR=1.25

# ---------- Academic API (OpenAlex — no key required) ----------
ACADEMIC_API_BASE_URL=https://api.openalex.org
ACADEMIC_API_MAILTO=you@example.com
ACADEMIC_API_RATE_LIMIT_PER_MINUTE=60

# ---------- Spring Boot ----------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
FRONTEND_ORIGIN=http://localhost:5173
FASTAPI_BASE_URL=http://localhost:8000
FASTAPI_INTERNAL_TOKEN=
MAX_UPLOAD_SIZE_MB=25
ASYNC_POOL_SIZE=2

# ---------- FastAPI ----------
PORT=8000
ALLOWED_CALLER_TOKEN=
LOG_LEVEL=info

# ---------- Frontend (Vite — only VITE_* reach the browser) ----------
VITE_API_BASE_URL=http://localhost:8080
VITE_NEON_AUTH_BASE_URL=

# ---------- Local docker-compose stand-ins (Infrastructure/docker) ----------
# Only used by the local containers, which replace Neon and Backblaze B2 for
# offline development. Choose any values; they never reach a real service.
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
